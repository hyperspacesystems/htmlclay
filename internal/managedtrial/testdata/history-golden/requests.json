    "method": "GET",
    "path": "/_/versions/notes.html"
  },
  {
    "name": "version-read",
    "method": "GET",
    "path": "/_/version/notes.html/{FROM}",
    "headers": {},
    "fromCase": {
      "case": "versions-list",
      "json": "versions.1.name"
    }
  },
  {
    "name": "data-loss-restore",
    "method": "POST",
    "path": "/_/data-loss/{FROM}",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": "{\"file\": \"notes.html\", \"choice\": \"restore\"}",
    "fromCase": {
      "case": "data-loss-event",
      "json": "event.id"
    }
  },
  {
    "name": "data-loss-cleared",

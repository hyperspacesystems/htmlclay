{
  "name": "a handler reconnects",
  "hosts": [
    "loose",
    "served"
  ],
  "served": "released",
  "setup": {
    "program": "none",
    "decision": "none"
  },
  "steps": [
    {
      "do": "subscribe",
      "as": "handler",
      "stream": "h",
      "expect": {
        "status": 200
      }
    },
    {
      "do": "subscribe",
      "as": "page",
      "stream": "p",
      "expect": {
        "status": 200
      }
    },
    {
      "do": "send",
      "as": "page",
      "frame": {
        "type": "wire/request",
        "id": "r1",
        "payload": {}
      },
      "expect": {
        "status": 200
      }
    },
    {
      "do": "see",
      "stream": "h",
      "type": "wire/request",
      "id": "r1"
    },
    {
      "do": "drop",
      "stream": "h"
    },
    {
      "do": "send",
      "as": "handler",
      "frame": {
        "type": "wire/done",
        "id": "r1"
      },
      "expect": {
        "status": 200
      }
    },
    {
      "do": "resubscribe",
      "stream": "h"
    },
    {
      "do": "see",
      "stream": "h",
      "type": "wire/done",
      "id": "r1"
    }
  ]
}

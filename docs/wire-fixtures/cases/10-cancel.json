{
  "name": "a cancelled request",
  "hosts": [
    "loose",
    "served"
  ],
  "served": "released",
  "setup": {
    "program": "wait",
    "decision": "allow"
  },
  "steps": [
    {
      "do": "subscribe",
      "as": "page",
      "stream": "p",
      "expect": {
        "status": 200
      }
    },
    {
      "do": "send",
      "as": "page",
      "frame": {
        "type": "wire/request",
        "id": "r1",
        "helper": "search",
        "payload": {}
      },
      "expect": {
        "status": 200
      }
    },
    {
      "do": "see",
      "stream": "p",
      "type": "wire/ack",
      "id": "r1"
    },
    {
      "do": "send",
      "as": "page",
      "frame": {
        "type": "wire/cancel",
        "id": "r1"
      },
      "expect": {
        "status": 200
      }
    },
    {
      "do": "see",
      "stream": "p",
      "type": "wire/error",
      "id": "r1",
      "code": "helper_cancelled"
    }
  ]
}

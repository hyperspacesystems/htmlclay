<!DOCTYPE html>
<html lang="en" autosave opens-in="edit">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Weekend Camping Checklist</title>
  <style>
    * { box-sizing: border-box; }
    html {
      font: 16.5px/1.6 system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color: #1A1C23;
      background: #FAF8F3;
    }
    body { max-width: 560px; margin: 52px auto 64px; padding: 0 20px; }
    .sheet {
      background: #FCFBF7;
      border: 1px solid #DFD9CB;
      border-radius: 16px;
      padding: 26px 28px 30px;
      box-shadow: 0 2px 6px rgba(26, 28, 35, 0.05), 0 16px 36px -16px rgba(26, 28, 35, 0.12);
    }
    .topbar {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
    }
    h1 { font-size: 27px; line-height: 1.2; margin: 0 0 6px; letter-spacing: -0.015em; }
    .sub { color: #5F6373; font-size: 14.5px; margin: 0; }
    .ai-anchor { position: relative; flex: none; }
    .ai-btn {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font: 600 12.5px/1 system-ui, -apple-system, sans-serif;
      color: #1A140B;
      background: #F4E3C1;
      border: 1px solid #DEC089;
      border-radius: 999px;
      padding: 6px 11px;
      cursor: pointer;
    }
    .ai-btn:hover { background: #EDD4A3; }
    .ai-pop {
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      z-index: 30;
      width: min(320px, calc(100vw - 48px));
      background: #FCFBF7;
      border: 1px solid #CFC7B4;
      border-radius: 12px;
      padding: 12px;
      box-shadow: 0 12px 30px -8px rgba(26, 28, 35, 0.22);
    }
    .ai-pop[hidden] { display: none; }
    .ai-pop label { display: block; font-size: 12px; font-weight: 600; color: #434654; margin-bottom: 6px; }
    .ai-row { display: flex; gap: 6px; }
    .ai-row input {
      flex: 1;
      min-width: 0;
      font: 13.5px/1.3 inherit;
      color: #1A1C23;
      background: #FAF8F3;
      border: 1px solid #CFC7B4;
      border-radius: 8px;
      padding: 7px 9px;
    }
    .ai-row input:focus { outline: none; border-color: #B8420E; }
    .ai-row button {
      font: 600 13px/1 inherit;
      padding: 7px 12px;
      border-radius: 8px;
      border: 0;
      background: #2C5E3B;
      color: #FAF8F3;
      cursor: pointer;
    }
    .ai-status { font-size: 12px; color: #5F6373; margin: 7px 0 0; }
    .ai-status:empty { display: none; }

    h2 {
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #2C5E3B;
      margin: 24px 0 8px;
    }
    ul[data-checklist] { list-style: none; margin: 0; padding: 0; }
    ul[data-checklist] li {
      display: flex;
      align-items: baseline;
      gap: 10px;
      padding: 6px 0;
      border-top: 1px solid #EFECE3;
    }
    ul[data-checklist] li:first-child { border-top: 0; }
    ul[data-checklist] li > input[type="checkbox"] {
      width: 16px;
      height: 16px;
      margin: 0;
      accent-color: #2C5E3B;
      cursor: pointer;
      flex: none;
      transform: translateY(2px);
    }
    ul[data-checklist] li:has(> input[type="checkbox"]:checked) {
      color: #6B7080;
      text-decoration: line-through;
    }
  </style>
</head>
<body>
  <article class="sheet">
    <div class="topbar">
      <div>
        <h1 editable="single-line">Weekend Camping Trip</h1>
        <p class="sub" editable="single-line">Two nights in the pines &middot; click any box to check off or type to edit</p>
      </div>
      <div class="ai-anchor" clay="editor-ui">
        <button type="button" class="ai-btn" id="ai-btn" aria-expanded="false" aria-controls="ai-pop">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.9 3.2 12 8.5l5.3 2.1L12 12.7 9.9 18l-2.1-5.3L2.5 10.6l5.3-2.1Z"/><path d="m18.5 14.5.9 2.1 2.1.9-2.1.9-.9 2.1-.9-2.1-2.1-.9 2.1-.9Z"/></svg>
          <span>AI</span>
        </button>
        <div class="ai-pop" id="ai-pop" hidden>
          <form id="ai-form">
            <label for="ai-input">Ask AI to update this packing list</label>
            <div class="ai-row">
              <input id="ai-input" type="text" placeholder="e.g. Add cold-weather layers for 35°F">
              <button type="submit">Ask</button>
            </div>
            <p class="ai-status" id="ai-status" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </div>

    <div id="list" editable>
      <h2>Shelter &amp; sleep</h2>
      <ul data-checklist="">
        <li><input type="checkbox" checked=""> Tent, poles, stakes, footprint</li>
        <li><input type="checkbox"> Sleeping bag &amp; insulated pad</li>
        <li><input type="checkbox"> Headlamp + spare batteries</li>
      </ul>

      <h2>Kitchen &amp; water</h2>
      <ul data-checklist="">
        <li><input type="checkbox" checked=""> Camp stove, fuel canister, lighter</li>
        <li><input type="checkbox"> Cast-iron skillet, mug, spork</li>
        <li><input type="checkbox"> 4L water jug &amp; filter</li>
        <li><input type="checkbox"> Coffee, oats, trail mix, foil packets</li>
      </ul>

      <h2>Trail &amp; safety</h2>
      <ul data-checklist="">
        <li><input type="checkbox"> Rain shell &amp; warm wool layer</li>
        <li><input type="checkbox"> First-aid kit, sunscreen, pocket knife</li>
        <li><input type="checkbox"> Offline trail map</li>
      </ul>
    </div>
  </article>

  <script src="https://clayjs.com/v1/clay.js?plugins=sync,wire,menu,undo,indicator"></script>
  <script src="https://clayjs.com/v1/clay-options.js"></script>
  <script>
    const listRoot = document.getElementById("list");
    listRoot.addEventListener("click", (e) => {
      const box = e.target;
      if (box?.tagName !== "INPUT" || box.type !== "checkbox") return;
      if (window.RichClay?.checklist && document.documentElement.getAttribute("editmode") === "true") return;
      if (box.checked) box.setAttribute("checked", "");
      else box.removeAttribute("checked");
    });

    const aiBtn = document.getElementById("ai-btn");
    const aiPop = document.getElementById("ai-pop");
    const aiForm = document.getElementById("ai-form");
    const aiInput = document.getElementById("ai-input");
    const aiStatus = document.getElementById("ai-status");

    function setAiOpen(open) {
      aiPop.hidden = !open;
      aiBtn.setAttribute("aria-expanded", String(open));
      if (open) aiInput.focus();
    }
    aiBtn.addEventListener("click", () => setAiOpen(aiPop.hidden));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !aiPop.hidden) setAiOpen(false);
    });
    document.addEventListener("pointerdown", (e) => {
      if (!aiPop.hidden && !e.target.closest(".ai-anchor")) setAiOpen(false);
    });
    aiForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const said = aiInput.value.trim();
      if (!said) return;
      aiStatus.textContent = "Sending to your agent...";
      const res = await clay.wire.send({ said }, { text: said });
      if (res.ok) {
        aiInput.value = "";
        aiStatus.textContent = "Sent to agent.";
      } else {
        aiStatus.textContent = "Run clay-wire listen camping.htmlclay in a terminal to connect an agent.";
      }
    });
  </script>
</body>
</html>

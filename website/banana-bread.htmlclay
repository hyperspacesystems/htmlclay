<!DOCTYPE html>
<html lang="en" autosave opens-in="edit">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>One-Bowl Banana Bread</title>
  <style>
    * { box-sizing: border-box; }
    [item][template] { display: none; }
    html:not([editmode="true"]) .ing-del { display: none; }
    html {
      font: 17px/1.6 Georgia, "Iowan Old Style", "Palatino Linotype", serif;
      color: #1A1C23;
      background: #FAF8F3;
    }
    body { max-width: 580px; margin: 52px auto 64px; padding: 0 20px; }
    .sheet {
      background: #FCFBF7;
      border: 1px solid #DFD9CB;
      border-radius: 16px;
      padding: 26px 28px 30px;
      box-shadow: 0 2px 6px rgba(26, 28, 35, 0.05), 0 16px 36px -16px rgba(26, 28, 35, 0.12);
    }
    .topbar {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
    }
    h1 { font-size: 29px; line-height: 1.18; margin: 0 0 6px; letter-spacing: -0.015em; }
    .sub { color: #5F6373; font-size: 15px; margin: 0; font-family: system-ui, -apple-system, sans-serif; }
    .ai-anchor { position: relative; flex: none; }
    .ai-btn {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font: 600 12.5px/1 system-ui, -apple-system, sans-serif;
      color: #1A140B;
      background: #F4E3C1;
      border: 1px solid #DEC089;
      border-radius: 999px;
      padding: 6px 11px;
      cursor: pointer;
    }
    .ai-btn:hover { background: #EDD4A3; }
    .ai-pop {
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      z-index: 30;
      width: min(320px, calc(100vw - 48px));
      background: #FCFBF7;
      border: 1px solid #CFC7B4;
      border-radius: 12px;
      padding: 12px;
      box-shadow: 0 12px 30px -8px rgba(26, 28, 35, 0.22);
      font-family: system-ui, -apple-system, sans-serif;
    }
    .ai-pop[hidden] { display: none; }
    .ai-pop label { display: block; font-size: 12px; font-weight: 600; color: #434654; margin-bottom: 6px; }
    .ai-row { display: flex; gap: 6px; }
    .ai-row input {
      flex: 1;
      min-width: 0;
      font: 13.5px/1.3 system-ui, -apple-system, sans-serif;
      color: #1A1C23;
      background: #FAF8F3;
      border: 1px solid #CFC7B4;
      border-radius: 8px;
      padding: 7px 9px;
    }
    .ai-row button {
      font: 600 13px/1 system-ui, -apple-system, sans-serif;
      padding: 7px 12px;
      border-radius: 8px;
      border: 0;
      background: #B8420E;
      color: #FAF8F3;
      cursor: pointer;
    }
    .ai-status { font-size: 12px; color: #5F6373; margin: 7px 0 0; }
    .ai-status:empty { display: none; }

    .sec-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
      margin: 24px 0 10px;
      font-family: system-ui, -apple-system, sans-serif;
    }
    h2 {
      font: 700 12px/1.2 system-ui, -apple-system, sans-serif;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #7A542E;
      margin: 0;
    }
    .scale-bar {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
    }
    .scale-label {
      font-size: 12.5px;
      font-weight: 600;
      color: #5F6373;
    }
    .scale-select {
      font: 600 13px/1.2 system-ui, -apple-system, sans-serif;
      color: #1A1C23;
      background: #F4F2EC;
      border: 1px solid #D5CEBE;
      border-radius: 8px;
      padding: 5px 10px;
      cursor: pointer;
    }
    .scale-bar:not([data-mode="custom"]) .scale-custom {
      display: none;
    }
    .scale-custom {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      color: #5F6373;
      font-weight: 600;
    }
    .scale-in {
      width: 56px;
      font: 600 13px/1.2 ui-monospace, SFMono-Regular, Menlo, monospace;
      color: #1A1C23;
      background: #FAF8F3;
      border: 1px solid #D5CEBE;
      border-radius: 8px;
      padding: 5px 7px;
      text-align: center;
    }

    .ing-list { list-style: none; margin: 0; padding: 0; }
    .ing-list li {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 0;
      border-top: 1px solid #EFECE3;
      font-family: system-ui, -apple-system, sans-serif;
    }
    .ing-list li:first-of-type { border-top: 0; }
    .amt {
      width: 54px;
      flex: none;
      font: 600 13.5px/1.2 ui-monospace, SFMono-Regular, Menlo, monospace;
      color: #1A1C23;
      background: #FAF8F3;
      border: 1px solid #DFD9CB;
      border-radius: 7px;
      padding: 5px 7px;
      text-align: right;
    }
    .unit, .add-unit {
      flex: none;
      font: 600 13px/1.2 system-ui, -apple-system, sans-serif;
      color: #434654;
      background: #F4F2EC;
      border: 1px solid #DFD9CB;
      border-radius: 7px;
      padding: 5px 8px;
      cursor: pointer;
    }
    .scaled {
      flex: none;
      font: 700 12px/1.2 ui-monospace, SFMono-Regular, Menlo, monospace;
      color: #8F4F06;
      background: #FBF1DC;
      border: 1px solid #EBD09B;
      border-radius: 6px;
      padding: 3px 7px;
      white-space: nowrap;
    }
    .scaled:empty { display: none; }
    .ing-item {
      flex: 1;
      min-width: 0;
      font: 15px/1.35 Georgia, serif;
      color: #1A1C23;
      background: transparent;
      border: 1px solid transparent;
      border-radius: 7px;
      padding: 4px 7px;
    }
    .ing-item:hover { border-color: #E6E1D5; background: #FAF8F3; }
    .ing-item:focus, .amt:focus, .unit:focus, .scale-select:focus, .scale-in:focus, .add-ing input:focus, .add-unit:focus {
      outline: none;
      border-color: #B8420E;
      background: #FAF8F3;
    }
    .ing-del {
      appearance: none;
      border: 0;
      background: transparent;
      color: #8A8E9E;
      font-size: 16px;
      line-height: 1;
      padding: 4px 6px;
      border-radius: 6px;
      cursor: pointer;
    }
    .ing-del:hover { color: #B8420E; background: #F4EFE6; }

    .add-ing {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
      margin-top: 10px;
      padding-top: 10px;
      border-top: 1px dashed #DFD9CB;
      font-family: system-ui, -apple-system, sans-serif;
    }
    .add-amt {
      width: 54px;
      font: 600 13px/1.2 ui-monospace, SFMono-Regular, Menlo, monospace;
      color: #1A1C23;
      background: #FAF8F3;
      border: 1px solid #D8D1C1;
      border-radius: 8px;
      padding: 6px 7px;
      text-align: right;
    }
    .add-unit {
      border-color: #D8D1C1;
      border-radius: 8px;
      padding: 6px 8px;
    }
    .add-text {
      flex: 1;
      min-width: 140px;
      font: 14px/1.3 system-ui, -apple-system, sans-serif;
      color: #1A1C23;
      background: #FAF8F3;
      border: 1px solid #D8D1C1;
      border-radius: 8px;
      padding: 6px 10px;
    }
    .add-ing button {
      font: 600 13px/1 system-ui, -apple-system, sans-serif;
      color: #1A1C23;
      background: #EFECE3;
      border: 1px solid #D5CEBE;
      border-radius: 8px;
      padding: 6px 13px;
      cursor: pointer;
    }
    .add-ing button:hover { background: #E5E0D3; }

    .steps-head { margin: 26px 0 10px; }
    .steps ol { margin: 0; padding-left: 22px; }
    .steps li { padding: 4px 0; }
  </style>
</head>
<body>
  <article class="sheet">
    <div class="topbar">
      <div>
        <h1 editable="single-line">One-Bowl Banana Bread</h1>
        <p class="sub" editable="single-line">1 loaf &middot; 10 min prep &middot; 55 min at 350&deg;F</p>
      </div>
      <div class="ai-anchor" clay="editor-ui">
        <button type="button" class="ai-btn" id="ai-btn" aria-expanded="false" aria-controls="ai-pop">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.9 3.2 12 8.5l5.3 2.1L12 12.7 9.9 18l-2.1-5.3L2.5 10.6l5.3-2.1Z"/><path d="m18.5 14.5.9 2.1 2.1.9-2.1.9-.9 2.1-.9-2.1-2.1-.9 2.1-.9Z"/></svg>
          <span>AI</span>
        </button>
        <div class="ai-pop" id="ai-pop" hidden>
          <form id="ai-form">
            <label for="ai-input">Ask AI for a recipe change</label>
            <div class="ai-row">
              <input id="ai-input" type="text" placeholder="e.g. Brown the butter &amp; add walnuts">
              <button type="submit">Ask</button>
            </div>
            <p class="ai-status" id="ai-status" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </div>

    <section id="ingredients" sap>
      <div class="sec-head">
        <h2>Ingredients</h2>
        <div class="scale-bar" data-mode="1" attr:data-mode="state.scalemode">
          <label class="scale-label" for="scale-select">Batch</label>
          <select id="scale-select" class="scale-select" bind="scalemode" persist>
            <option value="0.5">0.5&times;</option>
            <option value="1" selected>1&times;</option>
            <option value="2">2&times;</option>
            <option value="3">3&times;</option>
            <option value="custom">Custom&hellip;</option>
          </select>
          <label class="scale-custom" for="scale-custom-in">
            <span aria-hidden="true">&times;</span>
            <input id="scale-custom-in" class="scale-in" type="text" inputmode="decimal" autocomplete="off" bind="customscale" persist value="1.5" aria-label="Custom multiplier">
          </label>
        </div>
      </div>

      <ul class="ing-list" items="ingredients">
        <li item template data-id="">
          <input class="amt" type="text" inputmode="decimal" autocomplete="off" bind="amount" persist value="1" aria-label="Base amount">
          <select class="unit" bind="unit" persist aria-label="Unit">
            <option value="">whole</option>
            <option value="cup" selected>cup</option>
            <option value="tbsp">tbsp</option>
            <option value="tsp">tsp</option>
            <option value="oz">oz</option>
            <option value="lb">lb</option>
            <option value="g">g</option>
            <option value="ml">ml</option>
            <option value="pinch">pinch</option>
          </select>
          <output class="scaled" text="fmtScaled(item.amount, item.unit, root.scalemode, root.customscale)"></output>
          <input class="ing-item" type="text" bind="item" persist value="" aria-label="Ingredient">
          <button type="button" class="ing-del" trigger-remove aria-label="Remove ingredient">&times;</button>
        </li>
        <li item data-id="i-bananas">
          <input class="amt" type="text" inputmode="decimal" autocomplete="off" bind="amount" persist value="3" aria-label="Base amount">
          <select class="unit" bind="unit" persist aria-label="Unit">
            <option value="" selected>whole</option>
            <option value="cup">cup</option>
            <option value="tbsp">tbsp</option>
            <option value="tsp">tsp</option>
            <option value="oz">oz</option>
            <option value="lb">lb</option>
            <option value="g">g</option>
            <option value="ml">ml</option>
            <option value="pinch">pinch</option>
          </select>
          <output class="scaled" text="fmtScaled(item.amount, item.unit, root.scalemode, root.customscale)"></output>
          <input class="ing-item" type="text" bind="item" persist value="very ripe bananas, mashed" aria-label="Ingredient">
          <button type="button" class="ing-del" trigger-remove aria-label="Remove ingredient">&times;</button>
        </li>
        <li item data-id="i-butter">
          <input class="amt" type="text" inputmode="decimal" autocomplete="off" bind="amount" persist value="0.5" aria-label="Base amount">
          <select class="unit" bind="unit" persist aria-label="Unit">
            <option value="">whole</option>
            <option value="cup" selected>cup</option>
            <option value="tbsp">tbsp</option>
            <option value="tsp">tsp</option>
            <option value="oz">oz</option>
            <option value="lb">lb</option>
            <option value="g">g</option>
            <option value="ml">ml</option>
            <option value="pinch">pinch</option>
          </select>
          <output class="scaled" text="fmtScaled(item.amount, item.unit, root.scalemode, root.customscale)"></output>
          <input class="ing-item" type="text" bind="item" persist value="melted salted butter" aria-label="Ingredient">
          <button type="button" class="ing-del" trigger-remove aria-label="Remove ingredient">&times;</button>
        </li>
        <li item data-id="i-sugar">
          <input class="amt" type="text" inputmode="decimal" autocomplete="off" bind="amount" persist value="0.75" aria-label="Base amount">
          <select class="unit" bind="unit" persist aria-label="Unit">
            <option value="">whole</option>
            <option value="cup" selected>cup</option>
            <option value="tbsp">tbsp</option>
            <option value="tsp">tsp</option>
            <option value="oz">oz</option>
            <option value="lb">lb</option>
            <option value="g">g</option>
            <option value="ml">ml</option>
            <option value="pinch">pinch</option>
          </select>
          <output class="scaled" text="fmtScaled(item.amount, item.unit, root.scalemode, root.customscale)"></output>
          <input class="ing-item" type="text" bind="item" persist value="dark brown sugar" aria-label="Ingredient">
          <button type="button" class="ing-del" trigger-remove aria-label="Remove ingredient">&times;</button>
        </li>
        <li item data-id="i-egg">
          <input class="amt" type="text" inputmode="decimal" autocomplete="off" bind="amount" persist value="1" aria-label="Base amount">
          <select class="unit" bind="unit" persist aria-label="Unit">
            <option value="" selected>whole</option>
            <option value="cup">cup</option>
            <option value="tbsp">tbsp</option>
            <option value="tsp">tsp</option>
            <option value="oz">oz</option>
            <option value="lb">lb</option>
            <option value="g">g</option>
            <option value="ml">ml</option>
            <option value="pinch">pinch</option>
          </select>
          <output class="scaled" text="fmtScaled(item.amount, item.unit, root.scalemode, root.customscale)"></output>
          <input class="ing-item" type="text" bind="item" persist value="large egg, beaten" aria-label="Ingredient">
          <button type="button" class="ing-del" trigger-remove aria-label="Remove ingredient">&times;</button>
        </li>
        <li item data-id="i-vanilla">
          <input class="amt" type="text" inputmode="decimal" autocomplete="off" bind="amount" persist value="1" aria-label="Base amount">
          <select class="unit" bind="unit" persist aria-label="Unit">
            <option value="">whole</option>
            <option value="cup">cup</option>
            <option value="tbsp">tbsp</option>
            <option value="tsp" selected>tsp</option>
            <option value="oz">oz</option>
            <option value="lb">lb</option>
            <option value="g">g</option>
            <option value="ml">ml</option>
            <option value="pinch">pinch</option>
          </select>
          <output class="scaled" text="fmtScaled(item.amount, item.unit, root.scalemode, root.customscale)"></output>
          <input class="ing-item" type="text" bind="item" persist value="vanilla extract" aria-label="Ingredient">
          <button type="button" class="ing-del" trigger-remove aria-label="Remove ingredient">&times;</button>
        </li>
        <li item data-id="i-soda">
          <input class="amt" type="text" inputmode="decimal" autocomplete="off" bind="amount" persist value="1" aria-label="Base amount">
          <select class="unit" bind="unit" persist aria-label="Unit">
            <option value="">whole</option>
            <option value="cup">cup</option>
            <option value="tbsp">tbsp</option>
            <option value="tsp" selected>tsp</option>
            <option value="oz">oz</option>
            <option value="lb">lb</option>
            <option value="g">g</option>
            <option value="ml">ml</option>
            <option value="pinch">pinch</option>
          </select>
          <output class="scaled" text="fmtScaled(item.amount, item.unit, root.scalemode, root.customscale)"></output>
          <input class="ing-item" type="text" bind="item" persist value="baking soda &amp; pinch of salt" aria-label="Ingredient">
          <button type="button" class="ing-del" trigger-remove aria-label="Remove ingredient">&times;</button>
        </li>
        <li item data-id="i-flour">
          <input class="amt" type="text" inputmode="decimal" autocomplete="off" bind="amount" persist value="1.5" aria-label="Base amount">
          <select class="unit" bind="unit" persist aria-label="Unit">
            <option value="">whole</option>
            <option value="cup" selected>cup</option>
            <option value="tbsp">tbsp</option>
            <option value="tsp">tsp</option>
            <option value="oz">oz</option>
            <option value="lb">lb</option>
            <option value="g">g</option>
            <option value="ml">ml</option>
            <option value="pinch">pinch</option>
          </select>
          <output class="scaled" text="fmtScaled(item.amount, item.unit, root.scalemode, root.customscale)"></output>
          <input class="ing-item" type="text" bind="item" persist value="all-purpose flour" aria-label="Ingredient">
          <button type="button" class="ing-del" trigger-remove aria-label="Remove ingredient">&times;</button>
        </li>
      </ul>

      <form class="add-ing" trigger-add="ingredients">
        <input class="add-amt" type="text" inputmode="decimal" autocomplete="off" pattern="^(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)$" bind="amount" placeholder="0.5" required aria-label="New amount">
        <select class="add-unit" bind="unit" default="cup" aria-label="New unit">
          <option value="">whole</option>
          <option value="cup" selected>cup</option>
          <option value="tbsp">tbsp</option>
          <option value="tsp">tsp</option>
          <option value="oz">oz</option>
          <option value="lb">lb</option>
          <option value="g">g</option>
          <option value="ml">ml</option>
          <option value="pinch">pinch</option>
        </select>
        <input class="add-text" type="text" bind="item" placeholder="Add an ingredient (e.g. toasted walnuts)" required aria-label="New ingredient">
        <button type="submit">Add</button>
      </form>
    </section>

    <h2 class="steps-head">Steps</h2>
    <div class="steps" editable>
      <ol>
        <li>Heat the oven to 350&deg;F and butter an 8&times;4-inch loaf pan.</li>
        <li>Mash the bananas in a large bowl until mostly smooth, then whisk in the melted butter.</li>
        <li>Stir in the brown sugar, beaten egg, vanilla, baking soda, and salt.</li>
        <li>Fold in the flour just until no dry streaks remain.</li>
        <li>Bake 55 minutes until deep golden and a toothpick comes out clean. Cool 15 minutes before slicing.</li>
      </ol>
    </div>
  </article>

  <script>
    function fmtUnit(unit, val) {
      if (!unit) return "";
      if (val === 1) return " " + unit;
      if (unit === "cup") return " cups";
      if (unit === "lb") return " lbs";
      if (unit === "pinch") return " pinches";
      return " " + unit;
    }
    function fmtScaled(amount, unit, mode, custom) {
      const m = mode === "custom" ? parseFloat(custom) : Number(mode);
      const a = parseFloat(amount);
      if (!Number.isFinite(m) || m <= 0 || m === 1 || !Number.isFinite(a)) return "";
      const v = Math.round(a * m * 100) / 100;
      return "= " + v + fmtUnit(unit, v);
    }
  </script>
  <script src="https://clayjs.com/v1/clay.js?plugins=sync,wire,menu,undo,indicator"></script>
  <script src="https://clayjs.com/v1/clay-options.js"></script>
  <script src="https://clayjs.com/v1/sap.js"></script>
  <script>
    const app = document.getElementById("ingredients");
    const scaleSelect = document.getElementById("scale-select");
    const customIn = document.getElementById("scale-custom-in");

    function isDecimalInput(el) {
      return Boolean(el?.matches?.(".amt, .add-amt, #scale-custom-in"));
    }

    function sanitizeDecimal(raw) {
      let clean = String(raw || "").replace(/[^0-9.]/g, "");
      const dot = clean.indexOf(".");
      if (dot !== -1) {
        clean = clean.slice(0, dot + 1) + clean.slice(dot + 1).replace(/\./g, "");
      }
      return clean;
    }

    scaleSelect.addEventListener("change", () => {
      if (scaleSelect.value === "custom") {
        setTimeout(() => {
          customIn.focus();
          customIn.select();
        }, 0);
      }
    });

    app.addEventListener("beforeinput", (e) => {
      const el = e.target;
      if (!isDecimalInput(el) || !e.data || e.data.length !== 1) return;
      if (!/[0-9.]/.test(e.data)) {
        e.preventDefault();
        return;
      }
      if (e.data === ".") {
        const start = el.selectionStart ?? 0;
        const end = el.selectionEnd ?? 0;
        const rest = el.value.slice(0, start) + el.value.slice(end);
        if (rest.includes(".")) e.preventDefault();
      }
    });

    window.addEventListener("input", (e) => {
      const el = e.target;
      if (!isDecimalInput(el)) return;
      const clean = sanitizeDecimal(el.value);
      if (el.value !== clean) el.value = clean;
    }, true);

    app.addEventListener("keydown", (e) => {
      const el = e.target;
      if (!isDecimalInput(el)) return;
      if (e.key !== "ArrowUp" && e.key !== "ArrowDown") return;
      e.preventDefault();
      const cur = parseFloat(el.value);
      const base = Number.isFinite(cur) ? cur : 0;
      const min = el.id === "scale-custom-in" ? 0.25 : 0;
      const next = Math.max(min, Math.round((base + (e.key === "ArrowUp" ? 0.25 : -0.25)) * 10000) / 10000);
      el.value = String(next);
      el.dispatchEvent(new Event("input", { bubbles: true }));
      el.dispatchEvent(new Event("change", { bubbles: true }));
    });

    function syncControls() {
      for (const el of app.querySelectorAll("input[persist], textarea[persist], select[persist]")) {
        if (el.type === "checkbox" || el.type === "radio") { el.checked = el.hasAttribute("checked"); continue; }
        if (el.tagName === "SELECT") { for (const o of el.options) o.selected = o.hasAttribute("selected"); continue; }
        const saved = el.getAttribute("value") ?? "";
        if (el.value !== saved) el.value = saved;
      }
      Sap.refresh();
    }
    clay.ready.then(() => {
      clay.undo?.on("undo", syncControls);
      clay.undo?.on("redo", syncControls);
    });

    const aiBtn = document.getElementById("ai-btn");
    const aiPop = document.getElementById("ai-pop");
    const aiForm = document.getElementById("ai-form");
    const aiInput = document.getElementById("ai-input");
    const aiStatus = document.getElementById("ai-status");

    function setAiOpen(open) {
      aiPop.hidden = !open;
      aiBtn.setAttribute("aria-expanded", String(open));
      if (open) aiInput.focus();
    }
    aiBtn.addEventListener("click", () => setAiOpen(aiPop.hidden));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !aiPop.hidden) setAiOpen(false);
    });
    document.addEventListener("pointerdown", (e) => {
      if (!aiPop.hidden && !e.target.closest(".ai-anchor")) setAiOpen(false);
    });
    aiForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const said = aiInput.value.trim();
      if (!said) return;
      aiStatus.textContent = "Sending to your agent...";
      const res = await clay.wire.send({ said }, { text: said });
      if (res.ok) {
        aiInput.value = "";
        aiStatus.textContent = "Sent to agent.";
      } else {
        aiStatus.textContent = "Run clay-wire listen banana-bread.htmlclay in a terminal to connect an agent.";
      }
    });
  </script>
</body>
</html>
